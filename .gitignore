# CLI job data (jobs/) is local state. The interactive team's records (equipo/) ARE versioned
# in this project: they are the audit trail of how every result was produced and verified.
jobs/*
!jobs/.gitkeep


# Python / OS cruft
__pycache__/
*.pyc
.DS_Store

# Local environment logs
*.log

# Local, uncommitted policy override next to the tool (the project policy is .agent-team/policy.json)
agent-team/policy.json

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
# large regenerable Monte Carlo arrays
data/mc/*.npz

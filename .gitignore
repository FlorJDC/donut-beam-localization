# CLI job data (jobs/) is local state. The interactive team's records (equipo/) ARE versioned
# in this project: they are the audit trail of how every result was produced and verified.
jobs/*
!jobs/.gitkeep


# Python / OS cruft
__pycache__/
*.pyc
.DS_Store
*.egg-info/
build/
dist/
venv/
.venv/
.pytest_cache/

# Throwaway fixtures regenerated by the team's review scripts (e.g. work/verify/r03/g_break.py)
equipo/*/work/**/scratch/

# Local environment logs
*.log

# Local, uncommitted policy override next to the tool (the project policy is .agent-team/policy.json)
agent-team/policy.json

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
# large regenerable Monte Carlo arrays
data/mc/*.npz
data/mc/*_quick.json

# Private notes about the author's unpublished work (read locally by the team, never published)
docs/private/

# --quick development outputs (never the paper's products)
paper/figures/quick/
paper/generated/quick/
data/quick/

# --quick outputs of the informe scripts
informe/figures/quick/
informe/data/quick/
